{
  "scope": "Post hoc diagnosis. Reuses 32 vanilla step-24 held-out cached positions. Match counts use the actual FP32 bounded-head choice. Promoting only the final softcap is a counterfactual.",
  "device": "NVIDIA GeForce RTX 4090",
  "sweep_sha256": "acdf9018652f172f5ad017d0e53246dca617ee3e9c6925af69bdd5cf9f05d28d",
  "source": "\"\"\"Replay the registered cached tokens and isolate rounding at the vanilla softcap.\"\"\"\nimport copy\nimport json\nfrom pathlib import Path\nimport sys\n\nimport torch\n\nfrom scripts.e2e.precision_sweep import (\n    CACHED, PROMPT, Engine, KVCache, _autocast, _data_hash, file_digest,\n    load_checkpoint_model, tokenizing_distributed_data_loader,\n)\n\nsweep_file, ckpt, destination = map(Path, sys.argv[1:])\nsweep = json.loads(sweep_file.read_text())\nassert file_digest(ckpt / \"model_000024.pt\") == sweep[\"checkpoint_sha256\"]\nstock, _ = load_checkpoint_model(str(ckpt), 24, torch.device(\"cuda\", 0), \"eval\")\nfor module in stock.modules():\n    if isinstance(module, (torch.nn.Linear, torch.nn.Embedding)):\n        module.float()\nstock.tie_weights()\ncfg = stock.config\nvalid = tokenizing_distributed_data_loader(1, PROMPT + CACHED, \"val\", device=\"cuda\")\nnext(valid)\nrows = []\nfor block in sweep[\"blocks\"]:\n    x, y = next(valid)\n    assert _data_hash(x, y) == block[\"validation_sha256\"]\n    for mode in (\"fp32\", \"tf32\", \"bf16\", \"fp16\"):\n        model = copy.deepcopy(stock).eval()\n        engine = Engine(model, None)\n        cache = KVCache(1, cfg.n_kv_head, PROMPT + CACHED, cfg.n_embd // cfg.n_head, cfg.n_layer)\n        torch.set_float32_matmul_precision(\"highest\" if mode == \"fp32\" else \"high\")\n        head_scores = []\n        with torch.inference_mode(), _autocast(mode):\n            engine._forward(x[:, :PROMPT], cache)\n            hook = model.lm_head.register_forward_hook(lambda module, args, result: head_scores.append(result.detach()))\n            for i, token in enumerate(x[:, PROMPT:].split(1, dim=1)):\n                bounded = engine._forward(token, cache).flatten()\n                raw = head_scores.pop().flatten()\n                assert torch.equal(15.0 * torch.tanh(raw/15.0), bounded)\n                choice = int(bounded.argmax())\n                assert choice == block[\"formats\"][mode][\"argmax\"][i]\n                fp32_cap = 15.0 * torch.tanh(raw.float()/15.0)\n                rows.append(dict(block=block[\"block\"], token=i, mode=mode, original=choice,\n                                 raw_top=int(raw.argmax()), float_cap_top=int(fp32_cap.argmax()),\n                                 original_top_ties=int((bounded == bounded.max()).sum()),\n                                 float_cap_top_ties=int((fp32_cap == fp32_cap.max()).sum()),\n                                 raw_top_ties=int((raw == raw.max()).sum())))\n            hook.remove()\nrefs = {(r[\"block\"], r[\"token\"]): r[\"original\"] for r in rows if r[\"mode\"] == \"fp32\"}\nsummary = {}\nfor mode in (\"fp32\",\"tf32\",\"bf16\",\"fp16\"):\n    arm = [r for r in rows if r[\"mode\"] == mode]\n    summary[mode] = {k:sum(r[k] == refs[r[\"block\"],r[\"token\"]] for r in arm)\n                     for k in (\"original\",\"float_cap_top\",\"raw_top\")}\n    summary[mode][\"original_multiway_ties\"] = sum(r[\"original_top_ties\"] > 1 for r in arm)\n    summary[mode][\"original_tie_range\"] = [min(r[\"original_top_ties\"] for r in arm),\n                                            max(r[\"original_top_ties\"] for r in arm)]\nwith destination.open(\"x\") as out:\n    json.dump(dict(scope=\"Post hoc diagnosis. Reuses 32 vanilla step-24 held-out cached positions. Match counts use the actual FP32 bounded-head choice. Promoting only the final softcap is a counterfactual.\", device=torch.cuda.get_device_name(), sweep_sha256=file_digest(sweep_file),\n                   source=Path(__file__).read_text(), summary=summary, rows=rows), out, indent=2)\n    out.write(\"\\n\")\nprint(summary)\n",
