  "source": "\"\"\"Exercise the public greedy generator without teacher forcing on later FineWeb positions.\"\"\"\nimport copy, hashlib, json, sys\nfrom pathlib import Path\nimport torch\nfrom bio_inspired_nanochat.tokenizer import get_tokenizer\nfrom scripts.e2e.precision_sweep import Engine, _autocast, file_digest, load_checkpoint_model, tokenizing_distributed_data_loader\n\ndest=Path(sys.argv[1])\ncheckpoints=[(Path(sys.argv[2]),24),(Path(sys.argv[3]),2)]\nstream=tokenizing_distributed_data_loader(1,32,\"val\",device=\"cuda\")\nfor _ in range(16):\n    next(stream)\nprompts=[next(stream)[0][0].tolist() for _ in range(2)]\ntokenizer=get_tokenizer()\nrows=[]\nfor ckpt,step in checkpoints:\n    stock,_=load_checkpoint_model(str(ckpt),step,torch.device(\"cuda\",0),\"eval\")\n    for module in stock.modules():\n        if isinstance(module,(torch.nn.Linear,torch.nn.Embedding)):\n            module.float()\n    stock.tie_weights()\n    for i,tokens in enumerate(prompts):\n        arms={}\n        for mode in (\"fp32\",\"bf16\",\"fp16\"):\n            torch.set_float32_matmul_precision(\"highest\" if mode==\"fp32\" else \"high\")\n            model=copy.deepcopy(stock).eval()\n            with _autocast(mode):\n                generated=list(Engine(model,tokenizer).generate(tokens,num_samples=1,max_tokens=16,temperature=0.0,top_k=None,seed=1337))\n            arms[mode]={\"tokens\":[int(e[0][0]) for e in generated],\"masks\":[int(e[1][0]) for e in generated]}\n            del model\n        rows.append(dict(step=step,prompt_index=i,formats=arms))\n    del stock\nwith dest.open(\"x\") as f:\n    json.dump(dict(scope=\"Two later 32-token real validation prompts, after skipping 16 blocks, shared across two early checkpoints. Public Engine.generate, greedy, up to 16 emitted tokens per arm, fresh stock for each. No reference answers or quality judgment.\",prompts=prompts,\n                   source=Path(__file__).read_text(),head_sha256=file_digest(Path(\"bio_inspired_nanochat/gpt.py\")),shared_sha256=file_digest(Path(\"bio_inspired_nanochat/common.py\")), checkpoints={str(s):file_digest(c/f\"model_{s:06d}.pt\") for c,s in checkpoints},rows=rows),f,indent=2)\n    f.write(\"\\n\")\nprint([(v[\"step\"],v[\"prompt_index\"],{m:a[\"tokens\"]==v[\"formats\"][\"fp32\"][\"tokens\"] for m,a in v[\"formats\"].items()}) for v in rows])\n",
