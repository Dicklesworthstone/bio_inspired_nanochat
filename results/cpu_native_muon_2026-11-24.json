  "sources": {
    "muon_native_replay.py": {
      "content": "\"\"\"Reproduce the archived first Muon step and isolate orthogonalizer precision.\"\"\"\n\nimport hashlib\nimport json\nimport math\nimport sys\nfrom pathlib import Path\n\nimport torch\nfrom bio_inspired_nanochat.muon import Muon\n\n\nTRACES = {\n    \"native\": \"eafa2a825e66719f004e2123ccf35a7a07fc336d968f5c2ffe84e02d734936c5\",\n    \"reference\": \"1aa6434552adc6371b5bbd09873ab8b45692f34b036bcc69554894b6478b2763\",\n}\nLR = 0.02\nMOMENTUM = 0.85\nSTEPS = 5\n\n\ndef archived(root, arm):\n    path = root / f\"trace-{arm}\" / \"trace.pt\"\n    data = path.read_bytes()\n    assert hashlib.sha256(data).hexdigest() == TRACES[arm]\n    trace = torch.load(path, weights_only=True, map_location=\"cpu\")\n    result = {row[\"stage\"]: row[\"params\"] for row in trace[\"optim\"] if row[\"optimizer\"] == \"Muon\"}\n    assert set(result) == {\"pre\", \"post\"} and len(result[\"pre\"]) == len(result[\"post\"]) == 24\n    assert result[\"pre\"].keys() == result[\"post\"].keys()\n    return result\n\n\ndef production(entries):\n    params = {name: torch.nn.Parameter(data[\"weight\"].clone()) for name, data in entries.items()}\n    for name, param in params.items():\n        param.grad = entries[name][\"grad\"].clone()\n    Muon(list(params.values()), lr=LR, momentum=MOMENTUM, ns_steps=STEPS).step()\n    return {name: parameter.detach() for name, parameter in params.items()}\n\n\ndef orthogonalize(tensor, dtype):\n    value = tensor.to(dtype)\n    transposed = value.size(-2) > value.size(-1)\n    if transposed:\n        value = value.mT\n    value = value / (value.norm(dim=(-2, -1), keepdim=True) + 1e-7)\n    for _ in range(STEPS):\n        gram = value @ value.mT\n        polynomial = -4.7750 * gram + 2.0315 * gram @ gram\n        value = 3.4445 * value + polynomial @ value\n    return value.mT if transposed else value\n\n\ndef counterfactual(entries, dtype):\n    output = {}\n    for name, entry in entries.items():\n        grad = entry[\"grad\"].clone()\n        momentum = torch.zeros_like(grad).lerp_(grad, 1 - MOMENTUM)\n        g = grad.lerp_(momentum, MOMENTUM)\n        weight = entry[\"weight\"].clone()\n        output[name] = weight.add_(orthogonalize(g, dtype), alpha=-LR * max(1, weight.size(-2) / weight.size(-1))**0.5)\n    return output\n\n\ndef difference(a, b):\n    assert a.keys() == b.keys()\n    rows = {}\n    for name in a:\n        delta = a[name].double() - b[name].double()\n        rows[name] = {\"unequal\": int(torch.count_nonzero(delta)), \"max_abs\": float(delta.abs().max()),\n                      \"squared_l2\": float(delta.square().sum()), \"elements\": delta.numel()}\n    return {\"matrices\": len(rows), \"unequal_matrices\": sum(row[\"unequal\"] > 0 for row in rows.values()),\n            \"unequal_elements\": sum(row[\"unequal\"] for row in rows.values()),\n            \"max_abs\": max(row[\"max_abs\"] for row in rows.values()),\n            \"l2\": math.sqrt(math.fsum(row[\"squared_l2\"] for row in rows.values())), \"per_matrix\": rows}\n\n\ndef main(root, output):\n    torch.set_num_threads(2)\n    traces = {arm: archived(root, arm) for arm in TRACES}\n    before = {arm: trace[\"pre\"] for arm, trace in traces.items()}\n    assert before[\"native\"].keys() == before[\"reference\"].keys()\n    assert all(torch.equal(before[\"native\"][name][\"weight\"], before[\"reference\"][name][\"weight\"])\n               for name in before[\"native\"])\n    exact, high = {}, {}\n    for arm, snapshot in traces.items():\n        actual = production(snapshot[\"pre\"])\n        replay = counterfactual(snapshot[\"pre\"], torch.bfloat16)\n        for name in actual:\n            assert torch.equal(actual[name], snapshot[\"post\"][name][\"weight\"]), (arm, name, \"archived\")\n            assert torch.equal(replay[name], actual[name]), (arm, name, \"reference\")\n        exact[arm] = actual\n        high[arm] = counterfactual(snapshot[\"pre\"], torch.float32)\n    grads = {arm: {name: row[\"grad\"] for name, row in entries.items()} for arm, entries in before.items()}\n    by_precision = {\"bfloat16\": difference(exact[\"native\"], exact[\"reference\"]),\n                    \"float32\": difference(high[\"native\"], high[\"reference\"])}\n    document = {\"input_sha256\": TRACES, \"torch\": torch.__version__, \"lr\": LR, \"momentum\": MOMENTUM, \"steps\": STEPS,\n                \"archived_matrices_reproduced\": 48, \"pre_gradients\": difference(grads[\"native\"], grads[\"reference\"]),\n                \"cross_backend\": by_precision,\n                \"post_step_l2_reduction\": by_precision[\"bfloat16\"][\"l2\"] / by_precision[\"float32\"][\"l2\"]}\n    with output.open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump(document, stream, indent=2, sort_keys=True, allow_nan=False)\n        stream.write(\"\\n\")\n    print({key: {metric: row[metric] for metric in (\"unequal_matrices\", \"max_abs\", \"l2\")}\n           for key, row in by_precision.items()})\n\n\nif __name__ == \"__main__\":\n    if not __debug__:\n        raise RuntimeError(\"The optimizer replay requires assertions.\")\n    main(*map(Path, sys.argv[1:]))\n",
      "sha256": "2e297af030b86985ab452dfd238886d3a454639485dc3fae480ea9ea5020d395"
    },
    "muon_native_train.py": {
      "content": "\"\"\"Run the original CPU training probe with one optimizer precision intervention.\"\"\"\n\nimport json\nimport math\nimport runpy\nimport sys\nfrom pathlib import Path\n\nimport torch\n\nfrom bio_inspired_nanochat import muon\nfrom bio_inspired_nanochat.checkpoint_manager import build_model\nfrom muon_native_replay import STEPS, orthogonalize\n\n\nPROMPT = \"The synapse\"\nARMS = (\"bf16-native\", \"bf16-reference\", \"fp32-native\", \"fp32-reference\")\nRTOL, ATOL = 1e-5, 1e-6\n\n\ndef high_precision(matrix, steps):\n    assert steps == STEPS and matrix.device.type == \"cpu\"\n    return orthogonalize(matrix, torch.float32)\n\n\ndef train(arm):\n    assert arm in ARMS\n    if arm.startswith(\"fp32-\"):\n        muon.zeropower_via_newtonschulz5 = high_precision\n    sys.argv = [\"scripts.base_train\", \"--synapses=1\", \"--depth=2\", \"--max_seq_len=64\",\n                \"--device_batch_size=2\", \"--total_batch_size=128\", \"--num_iterations=2\",\n                \"--eval_every=2\", \"--eval_tokens=128\", \"--core_metric_every=-1\", \"--sample_every=-1\",\n                \"--device_type=cpu\", \"--model_tag=e2e_quick_start\", \"--syn_cfg.tau_rrp=60.0\",\n                \"--syn_cfg.enable_hebbian=1\", \"--syn_cfg.bistable_latch=1\", \"--save_every=1\"]\n    if arm.endswith(\"-reference\"):\n        sys.argv.append(\"--syn_cfg.native_presyn=0\")\n    runpy.run_module(\"scripts.base_train\", run_name=\"__main__\")\n\n\ndef measure(directory, arm, step):\n    checkpoint = directory / arm / \"base_checkpoints\" / \"e2e_quick_start\"\n    meta = json.loads((checkpoint / f\"meta_{step:06d}.json\").read_bytes())\n    commit = json.loads((checkpoint / f\"commit_{step:06d}.json\").read_bytes())\n    assert commit[\"complete\"] and meta[\"synaptic_config\"][\"native_presyn\"] == arm.endswith(\"-native\")\n    model, tokenizer, _ = build_model(str(checkpoint), step, torch.device(\"cpu\"), \"eval\")\n    tokens = tokenizer.encode(PROMPT)\n    assert tokens == [429, 326]\n    with torch.inference_mode():\n        logits, _ = model(torch.tensor([tokens]), train_mode=False)\n    assert logits.numel() == 904 and bool(logits.isfinite().all())\n    val = meta.get(\"val_bpb\")\n    assert val is None or math.isfinite(val)\n    return logits, val\n\n\ndef report(directory, output):\n    torch.set_num_threads(2)\n    stages = {}\n    for step in (1, 2):\n        cases = {arm: measure(directory, arm, step) for arm in ARMS}\n        panel = {}\n        for label, native, reference in ((\"bf16\", \"bf16-native\", \"bf16-reference\"),\n                                         (\"fp32\", \"fp32-native\", \"fp32-reference\"),\n                                         (\"reference_precision\", \"fp32-reference\", \"bf16-reference\"),\n                                         (\"native_precision\", \"fp32-native\", \"bf16-native\")):\n            lhs, lhs_bpb = cases[native]\n            rhs, rhs_bpb = cases[reference]\n            diff = lhs.double() - rhs.double()\n            close = torch.isclose(lhs, rhs, rtol=RTOL, atol=ATOL)\n            panel[label] = {\"logits\": diff.numel(), \"outside_tolerance\": int((~close).sum()),\n                            \"maximum_absolute_difference\": float(diff.abs().max()),\n                            \"native_or_first_val_bpb\": lhs_bpb, \"reference_or_second_val_bpb\": rhs_bpb}\n        stages[str(step)] = panel\n    assert stages[\"2\"][\"bf16\"][\"outside_tolerance\"] > 0\n    with output.open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"stages\": stages, \"scope\": \"same-command two-step training\", \"rtol\": RTOL, \"atol\": ATOL,\n                   \"prompt\": PROMPT, \"arms\": ARMS}, stream, sort_keys=True, indent=2, allow_nan=False)\n        stream.write(\"\\n\")\n    print(json.dumps(stages[\"2\"], sort_keys=True))\n\n\nif __name__ == \"__main__\":\n    if not __debug__:\n        raise RuntimeError(\"The training probe requires assertions.\")\n    phase, *args = sys.argv[1:]\n    if phase == \"train\":\n        assert len(args) == 1\n        train(args[0])\n    else:\n        assert phase == \"report\"\n        report(*map(Path, args))\n",
      "sha256": "0962f89fcbce656b1dc18aae014f88764097cd7db41c619b6fc19f463eab80b9"
    },
    "production.patch": {
      "content": "diff --git a/bio_inspired_nanochat/muon.py b/bio_inspired_nanochat/muon.py\nindex 5084071..7393de1 100644\n--- a/bio_inspired_nanochat/muon.py\n+++ b/bio_inspired_nanochat/muon.py\n@@ -23,7 +23,8 @@ def zeropower_via_newtonschulz5(G: Tensor, steps: int) -> Tensor:\n     if G.ndim < 2:\n         raise ValueError(\"Muon expects 2D parameters only\") # batched Muon implementation by @scottjmaddox, and put into practice in the record by @YouJiacheng\n     a, b, c = (3.4445, -4.7750,  2.0315)\n-    X = G.bfloat16()\n+    # Keep CPU gradients in FP32 so a rounding boundary does not amplify backend noise.\n+    X = G.float() if G.device.type == \"cpu\" else G.bfloat16()\n     if G.size(-2) > G.size(-1):\n         X = X.mT\n \n@@ -47,8 +48,7 @@ class Muon(torch.optim.Optimizer):\n \n     Muon internally runs standard SGD-momentum, and then performs an orthogonalization post-\n     processing step, in which each 2D parameter's update is replaced with the nearest orthogonal\n-    matrix. To efficiently orthogonalize each update, we use a Newton-Schulz iteration, which has\n-    the advantage that it can be stably run in bfloat16 on the GPU.\n+    matrix. The Newton-Schulz iteration uses FP32 on CPU and BF16 on the GPU.\n \n     Some warnings:\n     - This optimizer should not be used for the embedding layer, the final fully connected layer,\ndiff --git a/tests/test_synaptic_optimizer_stability.py b/tests/test_synaptic_optimizer_stability.py\nindex 1128081..a84a1a5 100644\n--- a/tests/test_synaptic_optimizer_stability.py\n+++ b/tests/test_synaptic_optimizer_stability.py\n@@ -19,6 +19,7 @@ import pytest\n import torch\n \n from bio_inspired_nanochat.gpt_synaptic import GPTSynaptic, GPTSynapticConfig\n+from bio_inspired_nanochat.muon import zeropower_via_newtonschulz5\n from bio_inspired_nanochat.synaptic import SynapticConfig\n \n pytestmark = pytest.mark.unit\n@@ -89,3 +90,16 @@ def test_default_recipe_never_rises_above_its_initial_loss():\n def test_planted_negative_legacy_scalar_lr_stalls_far_behind_the_default_recipe():\n     legacy, default = _losses(scalar_lr=LEGACY_SCALAR_LR), _losses()\n     assert legacy[-1] > default[-1] + 1.0, (legacy, default)\n+\n+\n+def test_cpu_muon_keeps_small_gradient_changes_across_a_bfloat16_boundary():\n+    midpoint = 1 + 2**-8\n+    lower = torch.tensor([[midpoint - 2**-22, 0.4], [0.3, 0.9]], dtype=torch.float32)\n+    upper = lower.clone()\n+    upper[0, 0] = midpoint + 2**-22\n+    assert lower.bfloat16()[0, 0] != upper.bfloat16()[0, 0]\n+\n+    low_update = zeropower_via_newtonschulz5(lower, steps=5)\n+    high_update = zeropower_via_newtonschulz5(upper, steps=5)\n+    assert low_update.dtype == high_update.dtype == torch.float32\n+    torch.testing.assert_close(low_update, high_update, rtol=0, atol=2e-6)\n",
      "sha256": "53d129c3abab4ef30d43aed331694f15f9e7b93ade0e1d28071b4f1dd015341b"
    },
    "verify_native_muon.py": {
      "content": "\"\"\"Verify the normal CPU training entry point and its reloaded checkpoints.\"\"\"\n\nimport json\nimport sys\nfrom pathlib import Path\n\nimport torch\n\nfrom muon_native_train import ATOL, RTOL, measure\n\n\ndef main(root, output):\n    torch.set_num_threads(2)\n    results = {}\n    for step in (1, 2):\n        native, native_bpb = measure(root, \"verified-native\", step)\n        reference, reference_bpb = measure(root, \"verified-reference\", step)\n        outside = int((~torch.isclose(native, reference, rtol=RTOL, atol=ATOL)).sum())\n        results[str(step)] = {\"logits\": native.numel(), \"outside_tolerance\": outside,\n                              \"max_abs\": float((native.double() - reference.double()).abs().max()),\n                              \"native_val_bpb\": native_bpb, \"reference_val_bpb\": reference_bpb}\n    with output.open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"steps\": results, \"rtol\": RTOL, \"atol\": ATOL}, stream, indent=2, sort_keys=True, allow_nan=False)\n        stream.write(\"\\n\")\n    print(results)\n    assert all(case[\"outside_tolerance\"] == 0 for case in results.values())\n\n\nif __name__ == \"__main__\":\n    if not __debug__:\n        raise RuntimeError(\"The native parity check requires assertions.\")\n    main(*map(Path, sys.argv[1:]))\n",
      "sha256": "5b99ab85d6d5fcf6b1da25145a0e1fb52399c4fceebeb6b4800fd478b89bc75f"
    }
  },
